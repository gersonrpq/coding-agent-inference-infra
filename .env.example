# Copy to .env (git-ignored) and fill in. Never commit real values.

# Gateway master key: administration only (creating virtual keys, the admin API)
export LITELLM_MASTER_KEY=

# Overflow endpoint key (Superlinked); only used when OVERFLOW_ENABLED=1
export SUPERLINKED_API_KEY=

# For setup/sync_lambda.sh and the ssh commands: the GPU machine (user@host) and its ssh key
export LAMBDA=
export LAMBDA_SSH_KEY=

# Generated into .env by setup/launch_cluster.sh the first time (leave empty)
export GRAFANA_ADMIN_PASSWORD=
export POSTGRES_PASSWORD=

# Virtual keys of the clients: created and appended to .env by `python3 script/make_keys.py` (leave empty)
export LITELLM_KEY_PI_DEMO=
export LITELLM_KEY_LOADGEN=
export LITELLM_KEY_TENANT_ACME=
export LITELLM_KEY_TENANT_BETA=
